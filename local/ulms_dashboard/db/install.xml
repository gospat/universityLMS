<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ulms_dashboard/db" VERSION="2026091700" COMMENT="XMLDB file for local_ulms_dashboard"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="local_ulms_faculty_admin_assignments" COMMENT="Maps faculty admin users to their primary faculty scope">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="facultyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="facultyid_fk" TYPE="foreign" FIELDS="facultyid" REFTABLE="local_ulms_faculties" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_ulms_department_admin_assignments" COMMENT="Maps department admin users to their primary department scope">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="departmentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="departmentid_fk" TYPE="foreign" FIELDS="departmentid" REFTABLE="local_ulms_departments" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_ulms_user_provisioning_log" COMMENT="Stores audit entries for manual and bulk ULMS user provisioning">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="createduserid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="targetrole" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="createmode" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="identifier" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="detailsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="actorid_idx" UNIQUE="false" FIELDS="actorid"/>
                <INDEX NAME="createduserid_idx" UNIQUE="false" FIELDS="createduserid"/>
                <INDEX NAME="targetrole_idx" UNIQUE="false" FIELDS="targetrole"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ulms_user_profile" COMMENT="Stores ULMS-specific academic metadata for managed users">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="facultyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="departmentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="programmeid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="studylevel" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="staffid" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userprofile_faculty_fk" TYPE="foreign" FIELDS="facultyid" REFTABLE="local_ulms_faculties" REFFIELDS="id"/>
                <KEY NAME="userprofile_department_fk" TYPE="foreign" FIELDS="departmentid" REFTABLE="local_ulms_departments" REFFIELDS="id"/>
                <KEY NAME="userprofile_programme_fk" TYPE="foreign" FIELDS="programmeid" REFTABLE="local_ulms_programmes" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="userid_uix" UNIQUE="true" FIELDS="userid"/>
                <INDEX NAME="studylevel_idx" UNIQUE="false" FIELDS="studylevel"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ulms_levels" COMMENT="Stores study-level definitions for the ULMS academic structure">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="code" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="code_unique" UNIQUE="true" FIELDS="code"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="sortorder_idx" UNIQUE="false" FIELDS="sortorder"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_ulms_user_management_log" COMMENT="Stores audit entries for ULMS admin user management actions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="targetuserid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="action" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="detailsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="ipaddress" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="actorid_fk" TYPE="foreign" FIELDS="actorid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="targetuserid_fk" TYPE="foreign" FIELDS="targetuserid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="action_idx" UNIQUE="false" FIELDS="action"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ulms_dashboard_session" COMMENT="Weekly class session rows tied to ULMS 6-tier academic structure">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="facultyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_faculties"/>
                <FIELD NAME="departmentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_departments"/>
                <FIELD NAME="programmeid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_programmes"/>
                <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_sessions (academic year)"/>
                <FIELD NAME="semesterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_semesters"/>
                <FIELD NAME="levelid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_levels"/>
                <FIELD NAME="moodlecourseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to Moodle core course table"/>
                <FIELD NAME="lecturer_userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to user.id of the session owner-lecturer"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="delivery_mode" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="lecture" SEQUENCE="false" COMMENT="lecture/tutorial/lab/seminar/workshop/office_hour/online_live"/>
                <FIELD NAME="weekday" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1=Mon..7=Sun"/>
                <FIELD NAME="start_minutes" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="540" SEQUENCE="false" COMMENT="Minutes since 00:00 (e.g. 540=09:00)"/>
                <FIELD NAME="duration_minutes" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="90" SEQUENCE="false"/>
                <FIELD NAME="term_start_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of first effective date"/>
                <FIELD NAME="term_end_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of last effective date"/>
                <FIELD NAME="skipdates" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of Y-m-d date strings explicitly cancelled"/>
                <FIELD NAME="location_mode" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="physical" SEQUENCE="false" COMMENT="physical|online"/>
                <FIELD NAME="location_label" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Room label (physical) or provider label (online)"/>
                <FIELD NAME="provider_key" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="bigbluebutton" SEQUENCE="false" COMMENT="bigbluebutton/lti_zoom/lti_msft_teams/custom_url"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to course_modules id (BBB/LTI provisioned)"/>
                <FIELD NAME="join_url_custom" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Raw URL when provider_key=custom_url"/>
                <FIELD NAME="recurrence" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="weekly" SEQUENCE="false" COMMENT="weekly|once_off"/>
                <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="scheduled" SEQUENCE="false" COMMENT="scheduled|cancelled|completed|rescheduled"/>
                <FIELD NAME="notes_public" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Notes visible to students"/>
                <FIELD NAME="notes_private" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Notes visible to lecturer/manager only"/>
                <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to mdl_event id for calendar sync"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="faculty_fk" TYPE="foreign" FIELDS="facultyid" REFTABLE="local_ulms_faculties" REFFIELDS="id"/>
                <KEY NAME="department_fk" TYPE="foreign" FIELDS="departmentid" REFTABLE="local_ulms_departments" REFFIELDS="id"/>
                <KEY NAME="programme_fk" TYPE="foreign" FIELDS="programmeid" REFTABLE="local_ulms_programmes" REFFIELDS="id"/>
                <KEY NAME="session_academic_fk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_ulms_sessions" REFFIELDS="id"/>
                <KEY NAME="semester_fk" TYPE="foreign" FIELDS="semesterid" REFTABLE="local_ulms_semesters" REFFIELDS="id"/>
                <KEY NAME="level_fk" TYPE="foreign" FIELDS="levelid" REFTABLE="local_ulms_levels" REFFIELDS="id"/>
                <KEY NAME="moodlecourse_fk" TYPE="foreign" FIELDS="moodlecourseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="lecturer_userid_fk" TYPE="foreign" FIELDS="lecturer_userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="mdl_locaulmsdashsess_lec_ix" UNIQUE="false" FIELDS="lecturer_userid, weekday, start_minutes"/>
                <INDEX NAME="mdl_locaulmsdashsess_cou_ix" UNIQUE="false" FIELDS="moodlecourseid, semesterid, levelid"/>
                <INDEX NAME="mdl_locaulmsdashsess_loc_ix" UNIQUE="false" FIELDS="location_label, weekday, start_minutes"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ulms_dashboard_attendance" COMMENT="Attendance per session occurrence per student (4 statuses)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to local_ulms_dashboard_session"/>
                <FIELD NAME="session_occurrence_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of the actual attendance date"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to user.id of the student"/>
                <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="present" SEQUENCE="false" COMMENT="present|absent|late|excused"/>
                <FIELD NAME="marked_by" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to user.id of lecturer/manager who marked"/>
                <FIELD NAME="marked_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of mark action"/>
                <FIELD NAME="comment" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="sessionid_fk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_ulms_dashboard_session" REFFIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="mdl_locaulmsdashatte_sesuseocc_uix" UNIQUE="true" FIELDS="sessionid, userid, session_occurrence_date"/>
                <INDEX NAME="mdl_locaulmsdashatte_ses_ix" UNIQUE="false" FIELDS="sessionid, session_occurrence_date"/>
                <INDEX NAME="mdl_locaulmsdashatte_use_ix" UNIQUE="false" FIELDS="userid, session_occurrence_date"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
