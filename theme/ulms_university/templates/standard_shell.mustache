{{!
    ULMS University standard pagelayout shell.
    Applies the unified portal shell (sidebar/topbar/filtered user menu/footer)
    for pages that use pagelayouts standard / admin / mypublic on portal routes
    (e.g. user profile view, user edit, calendar, user files, grade overview).
    Non-portal pages fall back to theme_boost/columns2 in the layout PHP, so this
    template only ever renders when get_portal_shell_context() is non-null.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}

    <header class="navbar fixed-top navbar-light bg-white navbar-expand ulms-portal-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
        <div class="container-fluid ulms-shell-topbar">
            <div class="ulms-shell-topbar__brand">
                {{#portalnav}}
                    <button type="button" class="btn btn-link ulms-shell-toggle" data-ulms-sidebar-toggle="true" aria-expanded="true" aria-controls="ulms-shell-sidebar" aria-label="{{#str}}toggleSideBar, theme_ulms_university{{/str}}" title="Collapse or expand the sidebar navigation">
                        <span class="ulms-shell-toggle__icon" aria-hidden="true"></span>
                        <span class="sr-only">Toggle navigation</span>
                    </button>
                {{/portalnav}}
                <a href="{{{ config.homeurl }}}" class="navbar-brand d-flex align-items-center m-0 p-0 aabtn">
                    {{# output.should_display_navbar_logo }}
                        <img src="{{output.get_compact_logo_url}}" class="logo me-2" alt="{{sitename}}">
                    {{/ output.should_display_navbar_logo }}
                    <span>{{{ sitename }}}</span>
                </a>
            </div>

            {{#portalnav}}
                <div class="ulms-shell-topbar__context">
                    <span class="ulms-shell-topbar__portal">{{portalname}}</span>
                    {{#currentuserrole}}
                        <span class="ulms-shell-topbar__role">{{currentuserrole}}</span>
                    {{/currentuserrole}}
                </div>
            {{/portalnav}}

            <div id="usernavigation" class="navbar-nav ms-auto h-100 ulms-shell-topbar__actions">
                {{{ output.navbar_plugin_output }}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                </div>
                {{{ output.edit_switch }}}
            </div>
        </div>
    </header>

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex"></div>
            <div class="ulms-shell">
                {{#portalnav}}
                    <aside id="ulms-shell-sidebar" class="ulms-shell-sidebar" aria-label="{{navigationaria}}">
                        <div class="ulms-shell-sidebar__inner">
                            <div class="ulms-shell-sidebar__brand">
                                <div class="ulms-shell-sidebar__eyebrow">{{eyebrow}}</div>
                                <div class="ulms-shell-sidebar__title">{{portalname}}</div>
                            </div>
                            <nav class="ulms-shell-sidebar__nav">
                                {{#navgroups}}
                                    <section class="ulms-shell-nav-group">
                                        <h2 class="ulms-shell-nav-group__title">{{heading}}</h2>
                                        <ul class="ulms-shell-nav-group__list">
                                            {{#items}}
                                                <li class="ulms-shell-nav-group__item">
                                                    {{#active}}
                                                        <span class="ulms-shell-nav-link ulms-shell-nav-link--active" aria-current="page" title="{{label}}">
                                                            {{#icon}}<span class="ulms-shell-nav-link__icon" aria-hidden="true">{{{icon}}}</span>{{/icon}}
                                                            <span class="ulms-shell-nav-link__label">{{label}}</span>
                                                        </span>
                                                    {{/active}}
                                                    {{^active}}
                                                        <a href="{{url}}" class="ulms-shell-nav-link" title="{{label}}">
                                                            {{#icon}}<span class="ulms-shell-nav-link__icon" aria-hidden="true">{{{icon}}}</span>{{/icon}}
                                                            <span class="ulms-shell-nav-link__label">{{label}}</span>
                                                        </a>
                                                    {{/active}}
                                                </li>
                                            {{/items}}
                                        </ul>
                                    </section>
                                {{/navgroups}}
                            </nav>
                        </div>
                    </aside>
                    <div class="ulms-shell-overlay" data-ulms-sidebar-dismiss="true" aria-hidden="true"></div>
                {{/portalnav}}
                <div id="page-content" class="pb-3 d-print-block ulms-shell-content">
                    {{{ output.full_header }}}
                    {{#secondarymoremenu}}
                        <div class="secondary-navigation d-print-none">
                            {{> core/moremenu}}
                        </div>
                    {{/secondarymoremenu}}
                    <div id="region-main-box">
                        {{#hasregionmainsettingsmenu}}
                        <div id="region-main-settings-menu" class="d-print-none">
                            <div> {{{ regionmainsettingsmenu }}} </div>
                        </div>
                        {{/hasregionmainsettingsmenu}}
                        <main id="region-main" aria-label="{{#str}}content{{/str}}">
                            {{#hasregionmainsettingsmenu}}
                                <div class="region_main_settings_menu_proxy"></div>
                            {{/hasregionmainsettingsmenu}}
                            {{{ output.course_content_header }}}
                            {{#overflow}}
                                <div class="container-fluid tertiary-navigation">
                                    <div class="navitem">
                                        {{> core/url_select}}
                                    </div>
                                </div>
                            {{/overflow}}
                            {{{ pagecontent }}}
                            {{{ output.course_content_footer }}}
                        </main>
                    </div>
                </div>
            </div>
        </div>
        <footer id="page-footer" class="ulms-portal-footer">
            <div class="ulms-portal-footer__inner">
                <div class="ulms-portal-footer__meta">
                    <span class="ulms-portal-footer__brand">{{{ sitename }}}</span>
                    <span class="ulms-portal-footer__login">{{{ output.login_info }}}</span>
                </div>

                {{# output.has_popover_links }}
                    <div class="ulms-portal-footer__support">
                        {{# output.page_doc_link }}
                            <span class="ulms-portal-footer__link">{{{ output.page_doc_link }}}</span>
                        {{/ output.page_doc_link }}
                        {{# output.services_support_link }}
                            <span class="ulms-portal-footer__link">{{{ output.services_support_link }}}</span>
                        {{/ output.services_support_link }}
                        {{# output.supportemail }}
                            <span class="ulms-portal-footer__link">{{{ output.supportemail }}}</span>
                        {{/ output.supportemail }}
                    </div>
                {{/ output.has_popover_links }}

                <div class="ulms-portal-footer__system">
                    {{{ output.standard_footer_html }}}
                </div>
            </div>

            <div class="footer-content-debugging footer-dark bg-dark text-light">
                <div class="container-fluid footer-dark-inner">
                    {{{ output.debug_footer_html }}}
                </div>
            </div>
        </footer>
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

<script data-ulms-shell-nav="1">
(function(){
  if (window.__ULMS_SHELL_NAV__) { return; }
  window.__ULMS_SHELL_NAV__ = true;
  var STORAGE_KEY = 'ulms_shell_state_v1';
  var shell = document.querySelector('.ulms-shell');
  var body = document.body;
  var toggles = document.querySelectorAll('[data-ulms-sidebar-toggle="true"]');
  var dismissers = document.querySelectorAll('[data-ulms-sidebar-dismiss="true"]');
  var sidebar = document.getElementById('ulms-shell-sidebar');
  if (!shell || !toggles.length) { return; }
  var bpXL = window.matchMedia ? window.matchMedia('(min-width: 1200px)') : null;
  var bpLG = window.matchMedia ? window.matchMedia('(min-width: 850px) and (max-width: 1199.98px)') : null;
  var bpMobile = window.matchMedia ? window.matchMedia('(max-width: 849.98px)') : null;
  var applyAria = function (expanded) { toggles.forEach(function (t) { t.setAttribute('aria-expanded', expanded ? 'true' : 'false'); }); };
  var remember = function () { try { window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ collapsed: shell.classList.contains('is-sidebar-collapsed'), open: shell.classList.contains('is-sidebar-open') })); } catch (e) {} };
  var restore = function () { try { var raw = window.localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : null; } catch (e) { return null; } };
  var collapse = function (on) { shell.classList.toggle('is-sidebar-collapsed', !!on); applyAria(!on); remember(); };
  var open = function (on) { shell.classList.toggle('is-sidebar-open', !!on); body.style.overflow = on && bpMobile && bpMobile.matches ? 'hidden' : ''; applyAria(on); remember(); };
  toggles.forEach(function (btn) { btn.addEventListener('click', function (ev) { ev.preventDefault(); if (bpMobile && bpMobile.matches) open(!shell.classList.contains('is-sidebar-open')); else collapse(!shell.classList.contains('is-sidebar-collapsed')); }, { passive: false }); });
  dismissers.forEach(function (el) { el.addEventListener('click', function () { open(false); }); });
  document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') open(false); }, true);
  document.addEventListener('click', function (ev) { if (!shell.classList.contains('is-sidebar-open') || !sidebar || !bpMobile || !bpMobile.matches) return; var node = ev.target; while (node && node !== document.body) { if (node === sidebar) return; if (node instanceof Element && node.closest && node.closest('[data-ulms-sidebar-toggle="true"]')) return; node = node.parentNode; } open(false); }, true);
  if (sidebar) {
    sidebar.addEventListener('click', function (ev) { var a = ev.target; while (a && a !== sidebar) { if (a instanceof Element && a.tagName === 'A' && a.getAttribute('href')) { if (bpMobile && bpMobile.matches) setTimeout(function () { open(false); }, 120); return; } a = a.parentNode; } }, true);
    var startX = null;
    sidebar.addEventListener('touchstart', function (e) { if (!e.touches || !e.touches.length) return; startX = e.touches[0].clientX; }, { passive: true });
    sidebar.addEventListener('touchend', function (e) { if (startX == null || !e.changedTouches || !e.changedTouches.length) return; if (e.changedTouches[0].clientX - startX <= -55) open(false); startX = null; }, { passive: true });
  }
  var applyBreakpoints = function () {
    if (bpXL && bpXL.matches) { open(false); var state = restore(); collapse(state ? !!state.collapsed : false); }
    else if (bpLG && bpLG.matches) { open(false); collapse(true); }
    else { collapse(false); open(false); }
    applyAria(shell.classList.contains('is-sidebar-open') || !shell.classList.contains('is-sidebar-collapsed'));
  };
  applyBreakpoints();
  [bpXL, bpLG, bpMobile].forEach(function (m) { if (m && typeof m.addEventListener === 'function') m.addEventListener('change', applyBreakpoints); else if (m && typeof m.addListener === 'function') m.addListener(applyBreakpoints); });
  window.addEventListener('resize', applyBreakpoints);
})();
</script>

{{{ output.standard_end_of_body_html }}}
</body>
</html>
