{{!
    ULMS secure pages shell with portal context.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}

    <header class="navbar fixed-top navbar-light bg-white navbar-expand ulms-portal-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
        <div class="container-fluid ulms-shell-topbar">
            <div class="ulms-shell-topbar__brand">
                {{#portalnav}}
                    <button type="button" class="btn btn-link ulms-shell-toggle" data-ulms-sidebar-toggle="true" aria-expanded="true" aria-controls="ulms-shell-sidebar" aria-label="Toggle sidebar navigation" title="Collapse or expand the sidebar navigation">
                        <span class="ulms-shell-toggle__icon" aria-hidden="true"></span>
                        <span class="sr-only">Toggle navigation</span>
                    </button>
                {{/portalnav}}
                <a href="{{{ config.homeurl }}}" class="navbar-brand d-flex align-items-center m-0 p-0 aabtn">
                    {{# output.should_display_navbar_logo }}
                        <img src="{{output.get_compact_logo_url}}" class="logo me-2" alt="{{sitename}}">
                    {{/ output.should_display_navbar_logo }}
                    <span>{{{ sitename }}}</span>
                </a>
            </div>

            {{#portalnav}}
                <div class="ulms-shell-topbar__context">
                    <span class="ulms-shell-topbar__portal">{{portalname}}</span>
                    {{#currentuserrole}}
                        <span class="ulms-shell-topbar__role">{{currentuserrole}}</span>
                    {{/currentuserrole}}
                </div>
            {{/portalnav}}

            <div id="usernavigation" class="navbar-nav ms-auto h-100 ulms-shell-topbar__actions">
                {{{ output.navbar_plugin_output }}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                </div>
                {{{ output.edit_switch }}}
            </div>
        </div>
    </header>

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="ulms-shell">
                {{#portalnav}}
                    <aside id="ulms-shell-sidebar" class="ulms-shell-sidebar" aria-label="{{navigationaria}}">
                        <div class="ulms-shell-sidebar__inner">
                            <div class="ulms-shell-sidebar__brand">
                                <div class="ulms-shell-sidebar__eyebrow">{{eyebrow}}</div>
                                <div class="ulms-shell-sidebar__title">{{portalname}}</div>
                            </div>
                            <nav class="ulms-shell-sidebar__nav">
                                {{#navgroups}}
                                    <section class="ulms-shell-nav-group">
                                        <h2 class="ulms-shell-nav-group__title">{{heading}}</h2>
                                        <ul class="ulms-shell-nav-group__list">
                                            {{#items}}
                                                <li class="ulms-shell-nav-group__item">
                                                    {{#active}}
                                                        <span class="ulms-shell-nav-link ulms-shell-nav-link--active" aria-current="page">{{label}}</span>
                                                    {{/active}}
                                                    {{^active}}
                                                        <a href="{{url}}" class="ulms-shell-nav-link">{{label}}</a>
                                                    {{/active}}
                                                </li>
                                            {{/items}}
                                        </ul>
                                    </section>
                                {{/navgroups}}
                            </nav>
                        </div>
                    </aside>
                    <div class="ulms-shell-overlay" data-ulms-sidebar-dismiss="true" aria-hidden="true"></div>
                {{/portalnav}}
                <div id="page-content" class="pb-3 d-print-block ulms-shell-content">
                    {{{ output.full_header }}}
                    <div id="region-main-box">
                        <div id="region-main">
                            {{{ output.course_content_header }}}
                            {{#headercontent}}
                                {{> core/activity_header }}
                            {{/headercontent}}
                            {{{ output.main_content }}}
                            {{{ output.course_content_footer }}}
                        </div>
                        {{#hasblocks}}
                        <aside id="block-region-side-pre" data-blockregion="side-pre" data-droptarget="1">
                            {{{sidepreblocks}}}
                        </aside>
                        {{/hasblocks}}
                    </div>
                </div>
            </div>
        </div>
        <footer id="page-footer" class="ulms-portal-footer">
            <div class="ulms-portal-footer__inner">
                <div class="ulms-portal-footer__meta">
                    <span class="ulms-portal-footer__brand">{{{ sitename }}}</span>
                    <span class="ulms-portal-footer__login">{{{ output.login_info }}}</span>
                </div>
                <div class="ulms-portal-footer__system">
                    {{{ output.standard_footer_html }}}
                </div>
            </div>
            <div class="footer-content-debugging footer-dark bg-dark text-light">
                <div class="container-fluid footer-dark-inner">
                    {{{ output.debug_footer_html }}}
                </div>
            </div>
        </footer>
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
