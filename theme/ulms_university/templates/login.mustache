{{!
    @template theme_ulms_university/login

    ULMS login page shell.

    The brand mark uses output.image_url, which this theme's renderer resolves
    to the 120x120 BELLS seal (pix/logo-mini). It deliberately does not use
    output.get_compact_logo_url, which returns the 600x200 banner: forcing that
    banner into the circular brand frame cropped away most of the wordmark.

    Example context (json):
    {
        "sitename": "BELLS TECH",
        "sitefullname": "BELLS UNIVERSITY OF TECHNOLOGY",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>"
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid pt-5 mt-0">
        <div id="page-content" class="row">
            <div id="region-main-box" class="col-12">
                <div id="region-main" class="col-12 h-100">
                <div class="ulms-login-brand d-flex justify-content-center align-items-center gap-3 mb-4">
                    <img src="{{output.image_url}}" class="ulms-login-brand__seal" alt="{{sitefullname}}" loading="eager">
                </div>
                <div class="login-wrapper">
                    <div class="login-container">
                    {{{ output.main_content }}}
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
