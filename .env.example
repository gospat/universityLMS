APP_ENV=production
APP_URL=https://lms.youruniversity.edu.ng
# PRODUCTION SAFETY: Always set APP_DEBUG=false on deployed environments.
# APP_DEBUG=true must ONLY ever be set on isolated developer workstations.
APP_DEBUG=false
# PRODUCTION SAFETY: ULMS_WEB_DEBUG_DISPLAY controls stack-trace visibility.
# Keep at 0 on any public-facing system.  Developers may override to 1 locally.
ULMS_WEB_DEBUG_DISPLAY=0
ULMS_GUEST_LOGIN_BUTTON=0
ULMS_AUTO_LOGIN_GUESTS=0
ULMS_PROTECT_USERNAMES=1
ULMS_PASSWORD_CHANGE_LOGOUT=1
ULMS_FORCE_LOGIN_FOR_PROFILES=1
ULMS_LOCKOUT_THRESHOLD=5
ULMS_LOCKOUT_WINDOW=900
ULMS_LOCKOUT_DURATION=1800
ULMS_PASSWORD_RESET_WINDOW=1800

# ===== Institution / Branding (PORTABLE CONFIGURATION — CUSTOMIZE PER UNIVERSITY) =====
# These values drive every visible ULMS-auth branded page: fatal error handler,
# HTTP 429 rate-limit page, clean-route 404 page, default email sender labels
# and support contact addresses.  Set these ONCE per installation and the rest
# of the shared ULMS codebase will render them without further code changes.
#
# Cascade priority used for each field (highest -> lowest):
#   1. INSTITUTION_* value set below          (NEW portable override — RECOMMENDED)
#   2. Legacy ULMS_DEFAULT_* / SMTP_* / RESEND_* names   (Bells-compatible fallbacks)
#   3. Generic "Your University" compile-time placeholder    (used only when empty)
#
# Full human-readable institution name.  Appears in page headers, footers,
# copyright notices, outbound email sender names and error pages.
INSTITUTION_NAME="Your University"
# Short 2–4 character monogram shown in the mini logo on ULMS-auth branded pages.
# If left unset, ULMS auto-derives it from the first letters of INSTITUTION_NAME.
INSTITUTION_SHORT_CODE="YU"
# Optional footer / copyright line override.  If unset ULMS generates a default
# "© {INSTITUTION_NAME} — All rights reserved. ULMS Platform." notice.
INSTITUTION_FOOTER=""
# Support mailbox shown on error pages; also used as default Reply-To / contact
# address on outbound system emails if no per-transport override is set.
INSTITUTION_SUPPORT_EMAIL=lms-support@youruniversity.edu.ng
# Human-readable support team label shown alongside the support email address.
INSTITUTION_SUPPORT_NAME="Your University LMS Support"
# Envelope From / bounce address used by default for all outbound notifications
# (welcome, password reset, course notifications).  Must be a domain you own.
INSTITUTION_NO_REPLY_EMAIL=no-reply@lms.youruniversity.edu.ng
# Human-readable sender label that appears next to INSTITUTION_NO_REPLY_EMAIL in
# end-user inboxes (e.g. "Covenant University LMS" <no-reply@…>).
INSTITUTION_SENDER_NAME="Your University LMS"

# ===== Email transport =====
# Change these defaults to real institution contact addresses:
ULMS_DEFAULT_NO_REPLY=no-reply@lms.youruniversity.edu.ng
ULMS_DEFAULT_SUPPORT_EMAIL=lms-support@youruniversity.edu.ng
ULMS_DEFAULT_SUPPORT_NAME="Your University LMS Support"
# Use `moodle` for Moodle/SMTP delivery or `resend` for the ULMS Resend HTTP transport.
# Resend is the RECOMMENDED default for most institutions.
ULMS_MAIL_TRANSPORT=resend

# === Database (Managed MySQL / PostgreSQL / local MySQL) ===
# DEDICATED LEAST-PRIVILEGE USER — NEVER use the MySQL root account.
# Provision BEFORE running the Moodle installer:
#   CREATE DATABASE ulms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'ulms_rw'@'%' IDENTIFIED BY '…replace with strong password…';
#   GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,ALTER,DROP,INDEX,
#         CREATE TEMPORARY TABLES,LOCK TABLES,CREATE VIEW,SHOW VIEW,
#         TRIGGER,EXECUTE ON ulms.* TO 'ulms_rw'@'%';
#   FLUSH PRIVILEGES;
# Special-character passwords: wrap the VALUE in DOUBLE QUOTES so the parser
# preserves `#`, ` ` (space), `!`, `$` and shell metacharacters literally:
#   DB_PASSWORD="Ab#9z!'pR x$$q*M9"
DB_TYPE=mysqli
DB_HOST=do-user-xxxx-0.b.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=ulms
DB_USER=ulms_rw
DB_PASSWORD="replace-with-strong-password-min-32-chars-special-chars-ok-if-quoted"
# -----------------------------------------------------------------------------
# Database TLS (MySQLi driver, Managed MySQL REQUIRED setting)
# -----------------------------------------------------------------------------
# Supported values (exact match to Moodle 4.5 lib/dml/mysqli_native_moodle_database.php):
#
#   DB_SSL_MODE=require
#       Enable TLS encryption.  Sets the PHP MYSQLI_CLIENT_SSL flag only.
#       Traffic to the DB is encrypted on the wire, but the server cert is
#       NOT cryptographically verified against a CA.  This prevents passive
#       eavesdropping but does NOT stop an attacker with a MITM position
#       and any self-signed cert.  Use ONLY inside private networks with
#       pre-existing trust.
#
#   DB_SSL_MODE=verify-full
#       Enable TLS encryption AND server certificate chain verification.
#       Sets MYSQLI_CLIENT_SSL | MYSQLI_CLIENT_SSL_VERIFY_SERVER_CERT.
#       REQUIRED for Managed MySQL DBaaS endpoints.  PHP MySQLi validates
#       the Managed MySQL server certificate chain against the OS trust
#       bundle at:
#         Debian/Ubuntu: /etc/ssl/certs/ca-certificates.crt
#       (package ca-certificates).  The PHP constant is named
#       MYSQLI_CLIENT_SSL_VERIFY_SERVER_CERT; historically this flag in
#       PHP MySQLi / mysqlnd performs **certificate chain validation**
#       against the trust bundle (so an expired / self-signed / private-CA
#       cert that is not anchored in the OS bundle fails with
#       "SSL routines::certificate verify failed").
#
#       Hostname / CN / SAN matching against the DB_HOST value is
#       implicitly provided by the underlying OpenSSL / mysqlnd handshake
#       when chain verification is enabled; but to get a STRONG,
#       independently-verified guarantee that hostname + chain BOTH
#       match, ALWAYS run the §2.2 pre-deploy diagnostic using
#       `mysql --ssl-mode=VERIFY_IDENTITY` (MySQL CLI).  That CLI mode
#       explicitly asserts both chain AND hostname identity and is the
#       authoritative gate before install.php.  If the CLI diagnostic
#       returns "Peer certificate … did not match expected" OR
#       "certificate verify failed", the PHP connection WILL also fail
#       for the same reason — fix DB_HOST / CA bundle before proceeding.
#
#       If CA certs are missing on the host, run:
#         sudo apt-get install -y ca-certificates && sudo update-ca-certificates
#
#   Leave EMPTY / commented out for local/dev environments (plain TCP on
#   127.0.0.1 or dev MySQL containers).  The Moodle driver ONLY sets TLS
#   flags when $CFG->dboptions['ssl'] is explicitly present.
#
# PRODUCTION (Managed MySQL DBaaS) => verify-full.
# Pre-deploy gate (always): §2.2 `mysql --ssl-mode=VERIFY_IDENTITY ...` CLI test.
DB_SSL_MODE=verify-full

# Moodle data directory — MUST live OUTSIDE the webroot.  On Ubuntu 24.04:
#   sudo mkdir -p /var/lib/ulms/moodledata
#   sudo chown www-data:www-data /var/lib/ulms/moodledata
#   sudo chmod 0750 /var/lib/ulms/moodledata
#   echo "Deny from all" | sudo tee /var/lib/ulms/moodledata/.htaccess
MOODLE_DATA_PATH="/var/lib/ulms/moodledata"
MOODLE_ADMIN=siteadmin

# === SMTP fallback (only used when ULMS_MAIL_TRANSPORT=moodle) ===
SMTP_HOSTS=smtp.example.com:587
SMTP_USER=mailer@example.com
SMTP_PASS="replace_with_real_secret"
SMTP_SECURE=tls
SMTP_PORT=587
SMTP_NO_REPLY=no-reply@lms.youruniversity.edu.ng
SMTP_SUPPORT_EMAIL=lms-support@youruniversity.edu.ng
SMTP_SUPPORT_NAME="Your University LMS Support"
ULMS_REPLY_TO=lms-support@youruniversity.edu.ng

# ULMS application + provisioning audit log path (absolute, outside webroot)
ULMS_LOG_FILE="/var/log/ulms/php-error.log"

# === Resend HTTP API mail transport (RECOMMENDED, used when ULMS_MAIL_TRANSPORT=resend) ===
# NEVER commit real Resend keys to git.  This file is gitignored for a reason.
# Key MUST start with `re_` prefix and be at least 40 characters long for production.
RESEND_API_KEY=
# Sender email domain MUST be verified inside the Resend dashboard:
#   https://resend.com/domains
# Do NOT send from a gmail.com / outlook.com / unverified domain in production.
RESEND_FROM_EMAIL=no-reply@lms.youruniversity.edu.ng
RESEND_FROM_NAME="Your University LMS"

# ========= Bells University of Technology — commented-out reference values (copy to .env to reuse Bells setup) =====
#
# The following lines reproduce the Bells University of Technology deployment
# configuration that originally shipped with this codebase.  They are
# intentionally commented out so that a new institution will NEVER see
# Bells-branded defaults rendered on public pages.  If you are deploying the
# Bells University instance, uncomment these lines in your own .env file:
#
# APP_URL=https://learn.bellsuniversity.edu.ng
# INSTITUTION_NAME="BELLS TECH UNIVERSITY"
# INSTITUTION_SHORT_CODE="BT"
# INSTITUTION_FOOTER="© BELLS TECH UNIVERSITY — All rights reserved. ULMS Platform."
# INSTITUTION_SUPPORT_EMAIL=lms-support@bellsuniversity.edu.ng
# INSTITUTION_SUPPORT_NAME="Bells University LMS Support"
# INSTITUTION_NO_REPLY_EMAIL=no-reply@learn.bellsuniversity.edu.ng
# INSTITUTION_SENDER_NAME="Bells University LMS"
# ULMS_DEFAULT_NO_REPLY=no-reply@learn.bellsuniversity.edu.ng
# ULMS_DEFAULT_SUPPORT_EMAIL=lms-support@bellsuniversity.edu.ng
# ULMS_DEFAULT_SUPPORT_NAME="Bells University LMS Support"
# DB_HOST=bells-ulms-db-do-user-xxxx-0.b.db.ondigitalocean.com
# SMTP_NO_REPLY=no-reply@learn.bellsuniversity.edu.ng
# SMTP_SUPPORT_EMAIL=lms-support@bellsuniversity.edu.ng
# SMTP_SUPPORT_NAME="Bells University LMS Support"
# ULMS_REPLY_TO=lms-support@bellsuniversity.edu.ng
# RESEND_FROM_EMAIL=no-reply@learn.bellsuniversity.edu.ng
# RESEND_FROM_NAME="Bells University LMS"
