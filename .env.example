APP_ENV=local
APP_URL=http://127.0.0.1:8000
# PRODUCTION SAFETY: Always set APP_DEBUG=false in deployed environments.
# Set APP_DEBUG=true only on isolated developer workstations.
APP_DEBUG=false
# PRODUCTION SAFETY: ULMS_WEB_DEBUG_DISPLAY controls stack-trace visibility.
# Keep at 0 on any public-facing system.  Developers may override to 1 locally.
ULMS_WEB_DEBUG_DISPLAY=0
ULMS_GUEST_LOGIN_BUTTON=0
ULMS_AUTO_LOGIN_GUESTS=0
ULMS_PROTECT_USERNAMES=1
ULMS_PASSWORD_CHANGE_LOGOUT=1
ULMS_FORCE_LOGIN_FOR_PROFILES=1
ULMS_LOCKOUT_THRESHOLD=5
ULMS_LOCKOUT_WINDOW=900
ULMS_LOCKOUT_DURATION=1800
ULMS_PASSWORD_RESET_WINDOW=1800
ULMS_DEFAULT_NO_REPLY=no-reply@ulms.local
ULMS_DEFAULT_SUPPORT_EMAIL=support@ulms.local
ULMS_DEFAULT_SUPPORT_NAME=ULMS Support
# Use `moodle` for Moodle/SMTP delivery or `resend` for the ULMS Resend HTTP transport.
ULMS_MAIL_TRANSPORT=moodle

DB_TYPE=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

MOODLE_DATA_PATH="/absolute/path/to/moodledata"
MOODLE_ADMIN=admin

SMTP_HOSTS=smtp.example.com:587
SMTP_USER=mailer@example.com
SMTP_PASS=replace_with_real_secret
SMTP_SECURE=tls
SMTP_PORT=587
SMTP_NO_REPLY=no-reply@example.com
SMTP_SUPPORT_EMAIL=support@example.com
SMTP_SUPPORT_NAME=ULMS Support
ULMS_REPLY_TO=support@example.com
ULMS_LOG_FILE="/absolute/path/to/moodledata/logs/php-error.log"

# PRODUCTION SAFETY: Never commit real Resend keys; use per-environment secrets manager.
# Key must start with `re_` prefix and be at least 40 characters long.
RESEND_API_KEY=
# Resend transport settings are only used when ULMS_MAIL_TRANSPORT=resend.
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=ULMS Support
