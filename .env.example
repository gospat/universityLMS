APP_ENV=production
APP_URL=https://learn.bellsuniversity.edu.ng
# PRODUCTION SAFETY: Always set APP_DEBUG=false on deployed environments.
# APP_DEBUG=true must ONLY ever be set on isolated developer workstations.
APP_DEBUG=false
# PRODUCTION SAFETY: ULMS_WEB_DEBUG_DISPLAY controls stack-trace visibility.
# Keep at 0 on any public-facing system.  Developers may override to 1 locally.
ULMS_WEB_DEBUG_DISPLAY=0
ULMS_GUEST_LOGIN_BUTTON=0
ULMS_AUTO_LOGIN_GUESTS=0
ULMS_PROTECT_USERNAMES=1
ULMS_PASSWORD_CHANGE_LOGOUT=1
ULMS_FORCE_LOGIN_FOR_PROFILES=1
ULMS_LOCKOUT_THRESHOLD=5
ULMS_LOCKOUT_WINDOW=900
ULMS_LOCKOUT_DURATION=1800
ULMS_PASSWORD_RESET_WINDOW=1800
# Change these defaults to real Bells University contact addresses:
ULMS_DEFAULT_NO_REPLY=no-reply@learn.bellsuniversity.edu.ng
ULMS_DEFAULT_SUPPORT_EMAIL=lms-support@bellsuniversity.edu.ng
ULMS_DEFAULT_SUPPORT_NAME="Bells University LMS Support"
# Use `moodle` for Moodle/SMTP delivery or `resend` for the ULMS Resend HTTP transport.
# Resend is the RECOMMENDED default for Bells University.
ULMS_MAIL_TRANSPORT=resend

# === Database (DigitalOcean Managed MySQL, Bells University) ===
# DEDICATED LEAST-PRIVILEGE USER — NEVER use the MySQL root account.
# Provision BEFORE running the Moodle installer:
#   CREATE DATABASE ulms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'ulms_rw'@'%' IDENTIFIED BY '…replace with strong password…';
#   GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,ALTER,DROP,INDEX,
#         CREATE TEMPORARY TABLES,LOCK TABLES,CREATE VIEW,SHOW VIEW,
#         TRIGGER,EXECUTE ON ulms.* TO 'ulms_rw'@'%';
#   FLUSH PRIVILEGES;
# Special-character passwords: wrap the VALUE in DOUBLE QUOTES so the parser
# preserves `#`, ` ` (space), `!`, `$` and shell metacharacters literally:
#   DB_PASSWORD="Ab#9z!'pR x$$q*M9"
DB_TYPE=mysqli
DB_HOST=bells-ulms-db-do-user-xxxx-0.b.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=ulms
DB_USER=ulms_rw
DB_PASSWORD="replace-with-strong-password-min-32-chars-special-chars-ok-if-quoted"

# Moodle data directory — MUST live OUTSIDE the webroot.  On Ubuntu 24.04:
#   sudo mkdir -p /var/lib/ulms/moodledata
#   sudo chown www-data:www-data /var/lib/ulms/moodledata
#   sudo chmod 0750 /var/lib/ulms/moodledata
#   echo "Deny from all" | sudo tee /var/lib/ulms/moodledata/.htaccess
MOODLE_DATA_PATH="/var/lib/ulms/moodledata"
MOODLE_ADMIN=siteadmin

# === SMTP fallback (only used when ULMS_MAIL_TRANSPORT=moodle) ===
SMTP_HOSTS=smtp.example.com:587
SMTP_USER=mailer@example.com
SMTP_PASS="replace_with_real_secret"
SMTP_SECURE=tls
SMTP_PORT=587
SMTP_NO_REPLY=no-reply@learn.bellsuniversity.edu.ng
SMTP_SUPPORT_EMAIL=lms-support@bellsuniversity.edu.ng
SMTP_SUPPORT_NAME="Bells University LMS Support"
ULMS_REPLY_TO=lms-support@bellsuniversity.edu.ng

# ULMS application + provisioning audit log path (absolute, outside webroot)
ULMS_LOG_FILE="/var/log/ulms/php-error.log"

# === Resend HTTP API mail transport (RECOMMENDED, used when ULMS_MAIL_TRANSPORT=resend) ===
# NEVER commit real Resend keys to git.  This file is gitignored for a reason.
# Key MUST start with `re_` prefix and be at least 40 characters long for production.
RESEND_API_KEY=
# Sender email domain MUST be verified inside the Resend dashboard:
#   https://resend.com/domains
# Do NOT send from a gmail.com / outlook.com / unverified domain in production.
RESEND_FROM_EMAIL=no-reply@learn.bellsuniversity.edu.ng
RESEND_FROM_NAME="Bells University LMS"
